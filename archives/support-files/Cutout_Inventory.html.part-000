<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Slopling · Cutout packets</title><style>*{box-sizing:border-box}body{margin:0;background:#f2eee5;color:#24352e;font:15px system-ui}header{padding:22px;max-width:1100px}h1{font:600 27px Georgia;margin:0 0 8px}p{margin:6px 0}.quiet{color:#667068;font-size:13px}nav{padding:12px 20px;display:flex;gap:9px;flex-wrap:wrap;background:#dedfd2;position:sticky;top:0;z-index:4}button,select,input,textarea{font:inherit;color:inherit;border:1px solid #acb6a6;border-radius:5px;padding:9px;background:#fffdf5}input[type=checkbox]{accent-color:#2a6856}button{cursor:pointer}button:disabled{opacity:.4;cursor:default}#query{flex:1;min-width:180px}#packet{max-width:330px}#summary{padding:12px 20px;background:#e8e5da;line-height:1.5}#summary strong{margin-right:8px}.bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:10px 20px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:10px;padding:12px 20px}.card{background:#fffcf5;border:1px solid #c6ccbd;border-radius:7px;overflow:hidden;position:relative}.card .preview{height:155px;background-color:#d8dbd0;background-image:linear-gradient(45deg,#c8cebf 25%,transparent 25%),linear-gradient(-45deg,#c8cebf 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#c8cebf 75%),linear-gradient(-45deg,transparent 75%,#c8cebf 75%);background-size:20px 20px;background-position:0 0,0 10px,10px -10px,-10px 0;display:flex;justify-content:center;align-items:center;cursor:pointer}.preview img{max-width:145px;max-height:145px;object-fit:contain}.card .info{padding:10px}.name{font-size:13px;font-weight:600;overflow-wrap:anywhere}.tag{font-size:11px;background:#e6eadf;display:inline-block;border-radius:3px;margin:3px 2px 3px 0;padding:3px 5px}.warn{background:#f3ddba}.selectbox{position:absolute;right:8px;top:7px;z-index:1;background:#fff9;padding:4px}.pick{width:18px;height:18px;margin:0}#more{display:block;margin:15px auto 25px}dialog{width:min(950px,96vw);max-height:93vh;background:#f5f1e8;border:1px solid #899a84;border-radius:10px;padding:18px}dialog::backdrop{background:#12251dcc}.detail{display:grid;grid-template-columns:1fr 1fr;gap:18px}canvas{width:100%;background:#d8dbd0}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;background:#e5e5da;padding:9px;max-height:230px;overflow:auto}textarea{width:100%;min-height:65px}#close{float:right}#detail-title{font-size:20px;margin-right:70px;overflow-wrap:anywhere}.actions{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}a{color:#215d4e}#status{font-size:13px;padding:8px 20px;min-height:32px}.badge{font-weight:600;color:#945825}.empty{padding:30px}footer{padding:15px 20px;color:#667068;font-size:12px}@media(max-width:600px){header{padding:16px}h1{font-size:23px}nav{padding:10px;position:static}.grid{grid-template-columns:repeat(2,minmax(0,1fr));padding:8px;gap:7px}.card .preview{height:130px}.preview img{max-width:125px;max-height:125px}.detail{grid-template-columns:1fr}#packet{width:100%;max-width:none}#summary{font-size:13px}}</style>
<body><header><h1>Use what we already have.</h1><p>Original cutouts, historical scale exports and the working Watson reference, organized without changing their pixels.</p><p class="quiet">Inventory first. A filename, anchor or “preferred” flag does not prove that a part assembles or animates correctly.</p></header><nav><select id="packet"></select><select id="bank"><option value="">All source banks</option><option value="original" selected>Original cutouts</option><option value="historical_scale">Historical scale exports</option><option value="watson_reference">Working Watson reference</option></select><select id="view"><option value="">All view labels</option><option>front</option><option>side</option><option>left_profile</option><option>right_profile</option><option>three_quarter</option><option>back</option><option>rear</option><option>unspecified</option></select><select id="slot"><option value="">All parts</option><option>head</option><option>torso</option><option>pelvis</option><option>upper_arm</option><option>forearm</option><option>hand</option><option>thigh</option><option>shin</option><option>foot</option><option>connector</option><option>prop</option><option>set</option></select><input id="query" type="search" placeholder="Search parts, filenames, expressions…"></nav><div id="summary"></div><div class="bar"><label><input id="partsOnly" type="checkbox" checked> Cutouts only</label><label><input id="issuesOnly" type="checkbox"> With review flags</label><span id="count"></span><button id="clear">Clear selection</button><button id="exportSelection">Export selected packet</button><button id="exportReviews">Export review notes</button></div><div id="status" role="status"></div><main id="grid" class="grid"></main><button id="more">Show more</button><footer id="footer"></footer>
<dialog id="detail"><button id="close">Close</button><h2 id="detail-title"></h2><div class="detail"><div><canvas id="preview" width="600" height="600"></canvas><label><input id="anchors" type="checkbox" checked> Show recorded joint guides</label><p class="quiet">Guides are inherited from the source and may be estimates. They are not automatically validated.</p></div><div id="detail-info"></div></div></dialog>
