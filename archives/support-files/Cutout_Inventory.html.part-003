e":"Watson_Rig_and_Motion_v2.zip","source_member":"Watson_Rig_Lab_v2/profile/parts/shin_far.png","exact_duplicate_ids":[],"recorded_joint_guides":[{"anchors":{"pivot":[63,29]},"global_source_pivot":[658,1043],"global_source_rect":[595,1014,176,385],"basis":"working Watson global pivot converted to local cutout pixels","status":"user_preferred_motion_reference"}],"thumbnail":"data:image/webp;base64,"},{"id":"watson_motion::side::boot_far","title":"Watson reference \u00b7 boot_far","category":"body","bank":"watson_reference","packet_ids":["watson_motion_reference"],"semantic_slot":"foot","view_label":"side","view_label_basis":"source_label","is_cutout":true,"width":281,"height":172,"has_alpha":true,"lighting":"unrecorded","review_status":"inventory_only","flags":[],"sha256_verified":"78ebf82f9b1e43fc54f12b73a0f4e21b0785a95fc20408911cbd5cdac65d24ef","native_file":"assets/78ebf82f9b1e43fc54f12b73a0f4e21b0785a95fc20408911cbd5cdac65d24ef.png","source_archive":"Watson_Rig_and_Motion_v2.zip","source_member":"Watson_Rig_Lab_v2/profile/parts/boot_far.png","exact_duplicate_ids":[],"recorded_joint_guides":[{"anchors":{"pivot":[61,48]},"global_source_pivot":[707,1362],"global_source_rect":[646,1314,281,172],"basis":"working Watson global pivot converted to local cutout pixels","status":"user_preferred_motion_reference"}],"thumbnail":"data:image/webp;base64,"},{"id":"watson_motion::side::thigh_near","title":"Watson reference \u00b7 thigh_near","category":"body","bank":"watson_reference","packet_ids":["watson_motion_reference"],"semantic_slot":"thigh","view_label":"side","view_label_basis":"source_label","is_cutout":true,"width":196,"height":376,"has_alpha":true,"lighting":"unrecorded","review_status":"inventory_only","flags":[],"sha256_verified":"21a9ca63febc230b9b8d17fa138f666dd4ae9f67444f6a8ef84f2c41276b8939","native_file":"assets/21a9ca63febc230b9b8d17fa138f666dd4ae9f67444f6a8ef84f2c41276b8939.png","source_archive":"Watson_Rig_and_Motion_v2.zip","source_member":"Watson_Rig_Lab_v2/profile/parts/thigh_near.png","exact_duplicate_ids":[],"recorded_joint_guides":[{"anchors":{"pivot":[137,29]},"global_source_pivot":[502,747],"global_source_rect":[365,718,196,376],"basis":"working Watson global pivot converted to local cutout pixels","status":"user_preferred_motion_reference"}],"thumbnail":"data:image/webp;base64,"},{"id":"watson_motion::side::shin_near","title":"Watson reference \u00b7 shin_near","category":"body","bank":"watson_reference","packet_ids":["watson_motion_reference"],"semantic_slot":"shin","view_label":"side","view_label_basis":"source_label","is_cutout":true,"width":243,"height":347,"has_alpha":true,"lighting":"unrecorded","review_status":"inventory_only","flags":[],"sha256_verified":"56bd7f7eeda58ffceec9b92471dc59cd0935d7c0a3389e7d65005d48d2c0fea6","native_file":"assets/56bd7f7eeda58ffceec9b92471dc59cd0935d7c0a3389e7d65005d48d2c0fea6.png","source_archive":"Watson_Rig_and_Motion_v2.zip","source_member":"Watson_Rig_Lab_v2/profile/parts/shin_near.png","exact_duplicate_ids":[],"recorded_joint_guides":[{"anchors":{"pivot":[199,29]},"global_source_pivot":[420,1064],"global_source_rect":[221,1035,243,347],"basis":"working Watson global pivot converted to local cutout pixels","status":"user_preferred_motion_reference"}],"thumbnail":"data:image/webp;base64,"},{"id":"watson_motion::side::boot_near","title":"Watson reference \u00b7 boot_near","category":"body","bank":"watson_reference","packet_ids":["watson_motion_reference"],"semantic_slot":"foot","view_label":"side","view_label_basis":"source_label","is_cutout":true,"width":276,"height":205,"has_alpha":true,"lighting":"unrecorded","review_status":"inventory_only","flags":[],"sha256_verified":"0cb20baddd63c96af95e2aef8856536952d1f42db022abc544c8d5374f5c6a13","native_file":"assets/0cb20baddd63c96af95e2aef8856536952d1f42db022abc544c8d5374f5c6a13.png","source_archive":"Watson_Rig_and_Motion_v2.zip","source_member":"Watson_Rig_Lab_v2/profile/parts/boot_near.png","exact_duplicate_ids":[],"recorded_joint_guides":[{"anchors":{"pivot":[92,42]},"global_source_pivot":[264,1345],"global_source_rect":[172,1303,276,205],"basis":"working Watson global pivot converted to local cutout pixels","status":"user_preferred_motion_reference"}],"thumbnail":"data:image/webp;base64,"}]};const NATIVE_FILES_AVAILABLE=false;</script>
<script>
const $=id=>document.getElementById(id),byId=Object.fromEntries(DATA.assets.map(a=>[a.id,a])),selected=new Set();let visible=[],shown=80,current=null,reviews={};try{reviews=JSON.parse(localStorage.getItem('slopling-cutout-review-v1')||'{}')}catch(e){};
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function saveReviews(){try{localStorage.setItem('slopling-cutout-review-v1',JSON.stringify(reviews))}catch(e){};}
function download(name,value){let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:'application/json'}));a.download=name;a.click();}
function subset(){let pid=$('packet').value,q=$('query').value.trim().toLowerCase(),bank=$('bank').value,view=$('view').value,slot=$('slot').value;return DATA.assets.filter(a=>(!pid||a.packet_ids.includes(pid))&&(!bank||a.bank===bank)&&(!view||a.view_label===view)&&(!slot||a.semantic_slot===slot)&&(!$('partsOnly').checked||a.is_cutout)&&(!$('issuesOnly').checked||a.flags.length)&&(!q||[a.id,a.title,a.file,a.state_code,a.semantic_slot].join(' ').toLowerCase().includes(q)));}
function summary(){const pid=$('packet').value,p=DATA.packets[pid],s=DATA.summary;$('summary').innerHTML=p?'<strong>'+esc(p.name)+'</strong>'+p.counts.original+' original records · '+p.counts.historical_scale+' historical scale records · '+p.counts.unique_native_files+' unique included files.<br><span class="badge">'+(p.kind==='motion_reference'?'User-preferred reference.':'Assembly compatibility still needs review.')+'</span> Source banks and view labels remain separate.':'<strong>'+s.original_cutout_records.toLocaleString()+' recovered original cutouts</strong> '+s.character_bindings+' character bindings · '+s.all_inventory_records.toLocaleString()+' inventory records · '+s.exact_duplicate_records_beyond_first.toLocaleString()+' exact duplicate records linked, not discarded.';}
function render(reset=true){if(reset)shown=80;visible=subset();summary();$('grid').innerHTML='';for(const a of visible.slice(0,shown)){const el=document.createElement('article');el.className='card';el.innerHTML='<label class="selectbox"><input class="pick" type="checkbox" '+(selected.has(a.id)?'checked':'')+' aria-label="Select '+esc(a.title||a.id)+'"></label><div class="preview"><img loading="lazy" src="'+a.thumbnail+'" alt="'+esc(a.title||a.id)+'"></div><div class="info"><div class="name">'+esc(a.title||a.id)+'</div><span class="tag">'+esc(a.view_label)+'</span><span class="tag">'+esc(a.bank==='historical_scale'?'past scale export':a.bank)+'</span><div class="quiet">'+a.width+' × '+a.height+' px · '+(a.recorded_joint_guides.some(g=>Object.keys(g.anchors||{}).length)?'joint guides':'no joint guide')+'</div>'+(a.exact_duplicate_ids.length?'<span class="tag">'+a.exact_duplicate_ids.length+' exact copies linked</span>':'')+(a.flags.length?'<span class="tag warn">Review '+a.flags.length+' flag'+(a.flags.length>1?'s':'')+'</span>':'')+'</div>';el.querySelector('.preview').onclick=()=>openDetail(a.id);el.querySelector('.pick').onchange=e=>{e.target.checked?selected.add(a.id):selected.delete(a.id);counts()};$('grid').append(el);}counts();$('more').hidden=shown>=visible.length;if(!visible.length)$('grid').innerHTML='<p class="empty">No assets match these filters. Try “All view labels” or another source bank before concluding a part is missing.</p>';}
function counts(){$('count').textContent=visible.length+' matches · '+selected.size+' selected';}
function guides(a){let out=[];function take(name,p,basis){if(Array.isArray(p)&&p.length>=2&&p.slice(0,2).every(Number.isFinite))out.push({name,x:p[0],y:p[1],basis});else if(p&&Number.isFinite(p.x)&&Number.isFinite(p.y))out.push({name,x:p.x,y:p.y,basis:p.basis||basis});}for(const[k,v]of Object.entries(a.pivot_points||{}))take(k,v,'source asset');for(const g of a.recorded_joint_guides||[])for(const[k,v]of Object.entries(g.anchors||{}))take(k,v,g.basis||'historical rig');return out;}
async function drawPreview(){const a=current;if(!a)return;let im=new Image();im.src=NATIVE_FILES_AVAILABLE&&a.native_file?a.native_file:a.thumbnail;try{await im.decode()}catch(e){im.src=a.thumbnail;await im.decode()}if(current!==a)return;const c=$('preview').getContext('2d');c.fillStyle='#d8dbd0';c.fillRect(0,0,600,600);const scale=Math.min(550/a.width,550/a.height),w=a.width*scale,h=a.height*scale,x=(600-w)/2,y=(600-h)/2;c.drawImage(im,x,y,w,h);if($('anchors').checked){c.font='12px system-ui';for(const p of guides(a)){if(p.x<0||p.x>a.width||p.y<0||p.y>a.height)continue;c.fillStyle='#b12d22';c.beginPath();c.arc(x+p.x*scale,y+p.y*scale,4,0,Math.PI*2);c.fill();c.fillStyle='#172b24';c.fillText(p.name,x+p.x*scale+6,y+p.y*scale-5);}}}
function openDetail(id){current=byId[id];const a=current,r=reviews[id]||{};$('detail-title').textContent=a.title||a.id;$('detail-info').innerHTML='<p><b>'+esc(a.semantic_slot)+' · '+esc(a.view_label)+'</b> · '+a.width+' × '+a.height+' px</p><p class="quiet">Lighting: '+esc(a.lighting)+' · '+(a.has_alpha?'alpha channel present':'no alpha channel')+'.</p><p>'+esc((a.notes||[]).join(' ')||a.note||'No source performance note recorded.')+'</p><p class="badge">'+esc(a.flags.join(' · ')||'Inventory only; no motion approval inferred.')+'</p><div class="actions">'+(NATIVE_FILES_AVAILABLE&&a.native_file?'<a href="'+a.native_file+'" download="'+esc(a.id.replace(/[^a-zA-Z0-9_-]/g,'_'))+PathExt(a.native_file)+'">Download unchanged PNG</a>':'<span class="quiet">Native bytes are in the extracted packet archives.</span>')+'<a href="https://github.com/hartswf0/slopling-odyssey/blob/main/docs/SOURCE_ARCHIVES.md">Source ZIP</a></div><label>Review <select id="review-state"><option value="inventory_only">Unreviewed</option><option value="candidate">Candidate for assembly</option><option value="repair">Needs repair</option><option value="exclude">Exclude from this assembly</option><option value="tested">Passed a named motion test</option></select></label><p><input id="evidence" style="width:100%" placeholder="Test filename / action / frame range" value="'+esc(r.evidence||'')+'"></p><textarea id="note" placeholder="What fits, what fails, which bank/view it belongs with">'+esc(r.note||'')+'</textarea><button id="save-review">Save review note</button><p class="quiet">A test approval is specific to the evidence you record.</p><details><summary>Original location, hash and joint data</summary><pre>'+esc(JSON.stringify({id:a.id,bank:a.bank,source_archive:a.source_archive,source_member:a.source_member,sha256:a.sha256_verified,native_file:a.native_file,exact_duplicates:a.exact_duplicate_ids,joint_guides:a.recorded_joint_guides,pivot_points:a.pivot_points},null,2))+'</pre></details>';$('review-state').value=r.status||'inventory_only';$('save-review').onclick=()=>{if($('review-state').value==='tested'&&!$('evidence').value.trim()){alert('Record the motion test and action before marking this part tested.');return;}reviews[id]={status:$('review-state').value,evidence:$('evidence').value.trim(),note:$('note').value.trim()};saveReviews();$('status').textContent='Review saved locally. Export review notes to keep or share them.';$('detail').close();};drawPreview();$('detail').showModal();}
function PathExt(p){return p.slice(p.lastIndexOf('.'));}
$('anchors').onchange=drawPreview;$('close').onclick=()=>$('detail').close();$('more').onclick=()=>{shown+=80;render(false)};$('clear').onclick=()=>{selected.clear();render(false)};
$('exportReviews').onclick=()=>download('cutout_review_notes.json',{schema:'slopling.cutout_reviews.v1',reviews});
$('exportSelection').onclick=()=>{if(!selected.size){$('status').textContent='Select existing cutouts first.';return;}const aa=[...selected].map(id=>byId[id]),warnings=[];if(new Set(aa.map(a=>a.bank)).size>1)warnings.push('Mixed source banks: confirm relative scale and compatibility.');if(aa.some(a=>a.view_label==='unspecified'))warnings.push('Some views are unrecorded.');const vv=new Set(aa.map(a=>a.view_label).filter(v=>v!=='unspecified'));if(vv.size>1)warnings.push('Multiple view labels: this may be a variant bank, not one assemblable rig.');download('assembly_selection_packet.json',{schema:'slopling.cutout_selection.v1',status:'proposed_not_assembly_approved',warnings,assets:aa.map(({thumbnail,...a})=>({...a,user_review:reviews[a.id]||null})),generation_policy:'Search the recovered inventory and test existing candidates before requesting a new part.'});$('status').textContent=warnings.length?warnings.join(' '):'Selection exported with source paths, hashes and recorded joints.';};
for(const id of ['packet','bank','view','slot','partsOnly','issuesOnly'])$(id).onchange=()=>render();$('query').oninput=()=>render();$('packet').onchange=()=>{if(DATA.packets[$('packet').value]?.kind==='motion_reference')$('bank').value='watson_reference';else if($('bank').value==='watson_reference')$('bank').value='original';render();};
const opts=[['','All packets'],...Object.values(DATA.packets).sort((a,b)=>{const priority=['char_mother','char_father','char_player','watson_motion_reference'];let ia=priority.indexOf(a.id),ib=priority.indexOf(b.id);if(ia>=0||ib>=0)return(ia<0?999:ia)-(ib<0?999:ib);return a.name.localeCompare(b.name)}).map(p=>[p.id,p.name])];for(const[id,name]of opts){const o=document.createElement('option');o.value=id;o.textContent=name;$('packet').append(o);}$('packet').value=DATA.packets.char_mother?'char_mother':Object.keys(DATA.packets)[0];$('footer').textContent=NATIVE_FILES_AVAILABLE?'Native PNGs are byte-identical to their archived sources. Original source archives are preserved.':'Portable preview catalog. Extract the full packet archives to use the included native PNGs; this standalone preview includes thumbnails and records.';render();
</script></body></html>
